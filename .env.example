# Copy to .env and paste your keys. .env is gitignored and must stay that way.
#
# Local convenience only. This is not a secrets management strategy, and nothing
# here should be treated as one.
#
# Only needed for the paid paths: --confidence, --judgement, and the demos.
# Every test and every deterministic run works with this file absent.

# console.anthropic.com -> API keys. Needs credits, and is billed separately
# from a Claude subscription.
ANTHROPIC_API_KEY=

# aistudio.google.com. Free tier is sufficient.
GEMINI_API_KEY=

# Optional model overrides. Provider-prefixed LiteLLM names.
# Defaults: anthropic/claude-opus-5, gemini/gemini-2.5-pro, anthropic/claude-sonnet-5
RATER_A=
RATER_B=
JUDGE=

# Optional. The model that drafts an RCA in `python -m rca_agent.draft`.
# Default: anthropic/claude-opus-5
DRAFTER=
